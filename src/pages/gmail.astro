---
import Base from '../layouts/Base.astro';
---

<!-- Unlisted utility: daily triage links here so an iPhone can try the Gmail
     app before falling back to desktop web Gmail. public/scripts/gmail.js
     does the work. The thread id stays in the fragment. -->
<Base title="Open in Gmail — Gian Trotta" description="Opens an email in Gmail." noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <section class="mx-auto max-w-3xl px-6 py-16">
    <p class="eyebrow">Gmail</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Open in Gmail</h1>

    <div data-gmail-valid hidden>
      <p class="mt-4 text-lg text-mist">Opening Gmail. If the app doesn't open, use the link below.</p>
      <p class="mt-2 text-mist">Account: <span data-gmail-account></span></p>
      <a data-gmail-web rel="noreferrer" class="mt-8 inline-block text-lg underline">Open in Gmail web</a>
      <a data-gmail-app rel="noreferrer" class="mt-4 block text-lg underline">Open in the Gmail app</a>
    </div>

    <p data-gmail-invalid hidden class="mt-4 text-lg text-mist">
      This link isn't a valid Gmail link.
    </p>
    <noscript>
      <p class="mt-4 text-lg text-mist">This page needs JavaScript to open Gmail.</p>
    </noscript>
  </section>
  <script type="module" src="/scripts/gmail.js"></script>
</Base>
