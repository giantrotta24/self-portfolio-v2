---
import { navLinks as links } from '../data/nav-links';
const current = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-20 border-b border-line bg-porcelain">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 px-6 py-5">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight">
      <!-- GT monogram, echoing favicon.svg. Decorative: the wordmark names the link.
           Below md the wordmark is visually hidden (sr-only) so the header shows
           just the mark, while the link keeps its accessible name. -->
      <span
        class="logo-mark relative grid size-8 shrink-0 place-items-center rounded-md bg-ink pb-px pr-px text-[0.75rem] leading-none text-porcelain"
        aria-hidden="true"
      >
        GT
        <span class="absolute bottom-[3px] right-[3px] size-[5px] rounded-full bg-flare"></span>
      </span>
      <span class="max-md:sr-only">Gian Trotta<span class="text-flare-deep">.</span></span>
    </a>

    <!-- Theme toggle, outside the drawer so it is one tap on phones. It sits
         just left of the hamburger (mobile) or the nav links (desktop).
         public/scripts/theme-toggle.js keeps aria-pressed in sync; global.css
         hides it until JS is known to run and drives the icon from the theme. -->
    <button
      type="button"
      class="theme-toggle -my-1 ml-auto grid size-10 shrink-0 place-items-center text-ink hover:text-flare-deep"
      aria-label="Dark mode"
      aria-pressed="false"
    >
      <svg class="theme-toggle-icon size-6" viewBox="0 0 24 24" aria-hidden="true">
        <mask id="theme-toggle-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
          <rect width="24" height="24" fill="#fff"></rect>
          <circle class="theme-toggle-cut" cx="17.5" cy="7" r="7" fill="#000"></circle>
        </mask>
        <g mask="url(#theme-toggle-mask)">
          <circle class="theme-toggle-body" cx="12" cy="12" r="5" fill="currentColor"></circle>
        </g>
        <path
          class="theme-toggle-rays"
          d="M12 1.5V4M12 20v2.5M1.5 12H4M20 12h2.5M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <!--
      This checkbox must remain a previous sibling of the dismiss label below
      and of #site-nav — the peer-checked CSS selectors (here and in the
      <style> block) depend on DOM order. Do not reorder these elements.
    -->
    <input
      type="checkbox"
      id="nav-toggle"
      class="peer sr-only md:hidden"
      aria-controls="site-nav"
      aria-label="Toggle menu"
    />

    <label
      for="nav-toggle"
      class="nav-toggle-btn -mr-2 cursor-pointer p-2 md:hidden"
    >
      <span class="sr-only">Menu</span>
      <span class="nav-icon relative block h-6 w-6" aria-hidden="true">
        <span class="nav-icon-bar absolute left-1 top-[5px] h-0.5 w-4 rounded-full bg-current"></span>
        <span class="nav-icon-bar absolute left-1 top-[11px] h-0.5 w-4 rounded-full bg-current"></span>
        <span class="nav-icon-bar absolute left-1 top-[17px] h-0.5 w-4 rounded-full bg-current"></span>
      </span>
    </label>

    <!-- Full-viewport dismiss target: clicking unchecks #nav-toggle via the label -->
    <label
      for="nav-toggle"
      class="nav-dismiss fixed inset-0 z-10 hidden cursor-default max-md:peer-checked:block"
      aria-hidden="true"
    ></label>

    <nav
      id="site-nav"
      class="absolute inset-x-0 top-full z-20 hidden max-h-[calc(100dvh-100%)] overflow-y-auto overscroll-contain border-b border-line bg-porcelain px-6 pb-6 shadow-lg max-md:peer-checked:block md:static md:z-auto md:block md:border-0 md:bg-transparent md:p-0 md:max-h-none md:overflow-visible md:shadow-none"
      aria-label="Main"
    >
      <ul
        class="flex flex-col gap-1 pt-2 md:flex-row md:flex-wrap md:items-center md:gap-x-6 md:gap-y-2 md:pt-0 md:text-sm"
      >
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={current.startsWith(href) ? 'page' : undefined}
                class="relative block py-2 text-mist after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-flare after:transition-transform after:duration-200 after:content-[''] hover:text-ink hover:after:scale-x-100 aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:after:scale-x-100 md:py-0 motion-reduce:after:transition-none"
              >
                {label}
              </a>
            </li>
          ))
        }
        <li class="mt-3 md:mt-0">
          <a
            href="/contact/"
            class="inline-block bg-ink px-4 py-2 font-semibold text-porcelain hover:bg-steel"
          >
            Book a free call
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-icon-bar {
    transform-origin: center;
    transition:
      transform 280ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 200ms ease;
  }

  #nav-toggle:checked + .nav-toggle-btn .nav-icon-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  #nav-toggle:checked + .nav-toggle-btn .nav-icon-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  #nav-toggle:checked + .nav-toggle-btn .nav-icon-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-icon-bar {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.checked) {
      toggle.checked = false;
      toggle.focus();
    }
  });
</script>
