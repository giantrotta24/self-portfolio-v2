---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import selfPortrait from '../assets/about/self-portrait.jpg';
import cleveland from '../assets/about/cleveland.jpg';
---

<Base
  title="About — Gian Trotta"
  description="Senior software engineer in Cleveland, Ohio. I've spent years making one very large website fast — now I do it for businesses whose owners I can shake hands with."
>
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-16">
    <p class="eyebrow eyebrow-accent">About</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">
      Gian Trotta
    </h1>

    <div class="mt-12 grid items-start gap-10 lg:grid-cols-12">
      <figure class="lg:col-span-5">
        <Picture
          src={selfPortrait}
          formats={['webp']}
          fallbackFormat="jpg"
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 400px, calc(100vw - 48px)"
          alt="Gian Trotta with his daughter"
          class="w-full max-w-md object-cover object-[center_20%] lg:max-w-none"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="mt-3 font-utility text-xs uppercase tracking-widest text-mist">
          Cleveland, Ohio · with my daughter
        </figcaption>
      </figure>

      <div class="space-y-6 text-lg leading-relaxed lg:col-span-7">
        <p>
          I've been at
          <a
            href="https://rvshare.com"
            class="font-semibold text-steel underline hover:text-ink"
            target="_blank"
            rel="noopener noreferrer"
          >RVshare</a>
          since 2019, now as a senior engineer on an RV rental marketplace that serves millions of
          visitors. Keeping that very large site fast, visible in search, and reliable is my day job.
        </p>
        <p>
          Now I'm bringing that work to local businesses and owners.
          I'm early here, so you get senior-level work,and a developer who wants your
          project to be one I'm proud to show.
        </p>
        <p>
          I live in Cleveland with my wife and daughter. In my free time I love watching Cleveland sports, playing poker, and collecting Magic: the Gathering cards.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-white" aria-label="Northeast Ohio">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <figure>
        <Picture
          src={cleveland}
          formats={['webp']}
          fallbackFormat="jpg"
          widths={[400, 800, 1600]}
          sizes="(min-width: 1024px) 976px, calc(100vw - 48px)"
          alt="Cleveland script sign overlooking the downtown skyline at dusk"
          class="w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-4 font-utility text-xs uppercase tracking-widest text-mist">
          Cleveland · Northeast Ohio
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="eyebrow">A little more context</p>
    <h2 class="section-heading mt-3 font-display text-2xl font-bold tracking-tight sm:text-3xl">
      Where I've been
    </h2>
    <div class="mt-10 grid gap-10 sm:grid-cols-3">
      <div>
        <p class="eyebrow">Websites I've built</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href="/case-studies/rusty/"
              class="inline-block font-display text-lg font-semibold tracking-tight transition-transform duration-150 hover:translate-x-1 hover:text-flare motion-reduce:hover:translate-x-0"
            >
              Rusty the Raccoon
            </a>
          </li>
          <li>
            <a
              href="/case-studies/fresh-beginnings/"
              class="inline-block font-display text-lg font-semibold tracking-tight transition-transform duration-150 hover:translate-x-1 hover:text-flare motion-reduce:hover:translate-x-0"
            >
              Fresh Beginnings Publishing
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Freelance work</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href="https://edhlab.gg"
              class="inline-block font-display text-lg font-semibold tracking-tight transition-transform duration-150 hover:translate-x-1 hover:text-flare motion-reduce:hover:translate-x-0"
              rel="noopener noreferrer"
              target="_blank"
            >
              EDHLAB
            </a>
          </li>
          <li>
            <a
              href="https://clockwork9.com"
              class="inline-block font-display text-lg font-semibold tracking-tight transition-transform duration-150 hover:translate-x-1 hover:text-flare motion-reduce:hover:translate-x-0"
              rel="noopener noreferrer"
              target="_blank"
            >
              Clockwork9
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">My 9-to-5</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href="https://rvshare.com"
              class="inline-block font-display text-lg font-semibold tracking-tight transition-transform duration-150 hover:translate-x-1 hover:text-flare motion-reduce:hover:translate-x-0"
              rel="noopener noreferrer"
              target="_blank"
            >
              RVshare
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    <a href="/contact/" class="btn-primary inline-block">
      Book a free 15-minute call
    </a>
  </section>
</Base>
