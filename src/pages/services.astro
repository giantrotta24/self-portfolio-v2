---
import Base from '../layouts/Base.astro';
import { contactHref, type ContactInterest } from '../data/contact-interests';

const services = [
  {
    name: 'Website Rescue',
    tagline: 'The flagship. Off Wix or Squarespace, onto a site you own.',
    description:
      'I move your site off the monthly-fee platform and rebuild it as a fast, modern site you own outright. Same content, better look, found on Google and by AI assistants — and no platform subscription ever again.',
    engagement: 'Fixed price · 2–3 weeks',
    interest: 'rescue',
    cta: 'Ask about a rescue',
  },
  {
    name: 'New Website Build',
    tagline: 'Starting from zero, built right the first time.',
    description:
      'For businesses without a site (or with one too far gone to rescue). You get the same result: fast, findable, fee-free, and easy to keep updated.',
    engagement: 'Fixed price · 2–4 weeks',
    interest: 'new-build',
    cta: 'Ask about a new build',
  },
  {
    name: 'Site Checkup',
    tagline: 'The low-risk front door.',
    description:
      'A fixed-price diagnostic of your current site: speed, Google visibility, AI-search visibility, and accessibility — delivered as a plain-English report with a prioritized fix list. If a rescue makes sense afterward, the checkup fee comes off the price.',
    engagement: 'Fixed price · 1 week',
    interest: 'checkup',
    cta: 'Ask about a checkup',
  },
  {
    name: 'Care Plan',
    tagline: 'Never let it rot again.',
    description:
      'Monthly updates, uptime and speed monitoring, and small content changes handled for you. For rescue and build clients who want a site that stays healthy.',
    engagement: 'Monthly retainer',
    interest: 'care-plan',
    cta: 'Ask about a care plan',
  },
] satisfies { interest: ContactInterest; [field: string]: string }[];
---

<Base
  title="Services — Web Developer & Website Design, Cleveland & Northeast Ohio | Gian Trotta"
  description="Website rescues, new builds, site checkups, and care plans for Cleveland and Northeast Ohio small businesses. Fixed prices, plain English, no platform fees."
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Services</h1>
    <p class="mt-4 max-w-2xl text-lg text-mist">
      Fixed-price help for small businesses in Cleveland and Northeast Ohio, whether your site
      needs rescuing, building from scratch, or just a tune-up. Every engagement is scoped in
      plain English before any money changes hands. Currently taking projects.
    </p>

    <div class="mt-12 space-y-8">
      {
        services.map(({ name, tagline, description, engagement, interest, cta }) => (
          <a
            href={contactHref(interest)}
            class="group block border border-line bg-white p-8 transition-[translate,border-color,box-shadow] duration-200 hover:-translate-y-1 hover:border-ink hover:shadow-lg focus-visible:border-ink motion-reduce:hover:translate-y-0"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="font-display text-2xl font-bold">{name}</h2>
              <p class="font-utility text-sm text-flare-deep">{engagement}</p>
            </div>
            <p class="mt-1 font-semibold text-steel">{tagline}</p>
            <p class="mt-3 max-w-3xl text-mist">{description}</p>
            <p class="mt-6 font-utility text-sm font-bold group-hover:text-flare-deep group-focus-visible:text-flare-deep">{cta} →</p>
          </a>
        ))
      }
    </div>

    <div class="mt-12">
      <h2 class="section-heading font-display text-2xl font-bold">Where I work</h2>
      <p class="mt-2 max-w-2xl text-mist">
        Based in Cleveland, Ohio, working with small businesses across Northeast Ohio — Cleveland,
        Akron, Parma, Lakewood, and the surrounding suburbs. Remote-friendly for the build itself;
        happy to meet in person for kickoff if you're local.
      </p>
    </div>

    <div class="mt-12 border-2 border-dashed border-ink bg-white p-8">
      <h2 class="section-heading font-display text-2xl font-bold">Not sure which fits?</h2>
      <p class="mt-2 max-w-2xl text-mist">
        Start with a free 15-minute call. You'll leave knowing what your site needs, whether or not
        we work together.
      </p>
      <a href="/contact/" class="btn-primary mt-6 inline-block">
        Book the call
      </a>
    </div>
  </section>
</Base>
