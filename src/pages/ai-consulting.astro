---
import Base from '../layouts/Base.astro';

const beforeAfter = [
  { item: 'Working on a change', before: 'one at a time', after: 'many at once' },
  { item: 'Getting it reviewed', before: 'waits in line', after: 'checked on arrival' },
  { item: 'Going live', before: 'scheduled, by hand', after: 'when checks pass' },
  { item: 'Waiting on a person', before: 'every step', after: 'exceptions only' },
];

const waits = [
  {
    title: 'One workspace, one task',
    body: "There's only one place to build and test, so work lines up behind whatever is in progress. Adding AI doesn't help if it has to wait its turn too.",
  },
  {
    title: 'Review is a queue',
    body: 'Every change waits for someone to find time to read it. The more AI writes, the longer that line gets.',
  },
  {
    title: 'Releases are an event',
    body: 'Going live happens on a schedule, one step at a time, by whoever knows the steps. Finished work sits until then.',
  },
];

const auditFindings = [
  { item: 'Where work waits on a person', result: 'mapped' },
  { item: 'What AI can take over', result: 'listed' },
  { item: 'Guardrails you need first', result: 'spelled out' },
  { item: 'What to automate first', result: 'ranked' },
];

const afterAudit = [
  {
    name: 'Build',
    body: 'I set up the system on one real product: separate workspaces for each task, automatic checks on every change, and releases that happen when those checks pass. Your team keeps all of it.',
    engagement: 'Fixed price · 4–6 weeks',
  },
  {
    name: 'Support',
    body: 'Monthly help tuning the rules, adding automation as your team trusts it with more, and a second opinion on new tools.',
    engagement: 'Monthly retainer',
  },
];

const system = [
  {
    who: 'People',
    name: 'Set the rules',
    body: "Decide what gets built and what's off-limits: which parts of the product AI can change, and what every change has to prove before it counts.",
    accent: true,
  },
  {
    who: 'AI',
    name: 'Works on many things at once',
    body: 'Each task gets its own isolated copy of your app, so many changes get built and tested at the same time without stepping on each other.',
  },
  {
    who: 'Checks',
    name: 'Decide what ships',
    body: 'Automated checks verify every change. Routine ones go live on their own. Anything outside the rules stops and waits for a person.',
  },
];

const ownSetup = [
  'Several AI agents work at the same time, each in its own isolated copy of the code.',
  "They work under hard limits they can't get around: no sending changes straight to the live site, no erasing the record of what changed, and no editing their own rules.",
  'Every blocked action is logged. I widen what agents may do from that log, not from a hunch.',
  'On this site, AI agents put their own changes live once the automated checks pass.',
];

const questions = [
  {
    q: 'Is it safe to let AI ship on its own?',
    a: "Only inside rules the system enforces, not rules it's asked to follow. Routine changes that pass every check go live. Anything else waits for a person.",
  },
  {
    q: "We're not ready for AI to release anything.",
    a: 'Then start with separate workspaces and automatic checks, and keep a person approving releases. You can hand over more once the checks have earned it.',
  },
  {
    q: "I'm not technical. Is this for me?",
    a: "Yes. The audit report is written for the person paying for it. If an outside developer or agency builds your product, I'll work with them directly.",
  },
];
---

<Base
  title="AI Delivery Systems for Software Teams | Gian Trotta"
  description="I set up the system around your AI so its work goes live as fast as it gets written, inside rules you set. Start with a fixed-price delivery audit."
  noindex
>
  <section class="mx-auto max-w-6xl overflow-x-clip px-6 pb-20 pt-16 lg:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-7">
        <p class="eyebrow eyebrow-accent text-sm!">For founders and software leaders</p>
        <h1
          class="mt-4 max-w-full font-display text-4xl font-bold leading-[1.15] tracking-tight text-balance sm:text-5xl lg:text-[clamp(2.75rem,4.4vw,3.25rem)]"
        >
          AI can build five things at once.{' '}
          <span class="hero-underline">Your releases still wait in line.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-mist">
          I set up the system around your AI so its work goes live as fast as it gets written,
          inside rules you set. No more waiting on someone's free afternoon.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <a href="/contact/" class="btn-primary text-center sm:text-left">
            Book a free 15-minute call
          </a>
          <a href="#audit" class="btn-secondary text-center sm:text-left">Start with an audit</a>
        </div>
      </div>

      <aside
        class="receipt-wrap min-w-0 w-full max-w-md justify-self-center transition-transform duration-300 sm:max-w-lg lg:col-span-5 lg:max-w-none lg:justify-self-stretch lg:-rotate-2 lg:hover:rotate-0 motion-reduce:transition-none"
        aria-label="How delivery changes, before and after"
      >
        <div class="receipt-paper px-5 py-8 font-utility sm:px-7 sm:py-9">
          <p class="text-xs uppercase tracking-widest text-mist">Delivery audit · before / after</p>
          <dl class="mt-5 text-sm">
            {
              beforeAfter.map(({ item, before, after }, i) => (
                <div class={`py-3 ${i < beforeAfter.length - 1 ? 'border-b border-dotted border-line' : ''}`}>
                  <dt>{item}</dt>
                  <dd class="mt-1 flex flex-wrap items-baseline justify-between gap-x-3">
                    <span class="text-mist line-through decoration-mist/60">{before}</span>
                    <span class="font-bold text-steel">{after}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 border-t border-dashed border-line pt-4 text-xs leading-relaxed text-mist">
            Every audit starts by finding the places your work waits on a person.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-line bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Where the work waits
      </h2>
      <p class="mt-4 max-w-2xl text-mist">
        Most teams already use AI to write code. It doesn't get to customers any faster, because
        everything around the code still moves one piece at a time.
      </p>
      <dl class="mt-10 border-t border-line">
        {
          waits.map(({ title, body }) => (
            <div class="reveal grid gap-2 border-b border-line py-6 md:grid-cols-12 md:gap-8">
              <dt class="font-display text-xl font-bold md:col-span-4">{title}</dt>
              <dd class="max-w-prose text-mist md:col-span-8">{body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="audit" class="scroll-mt-8 border-t border-line">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Start with an audit
      </h2>
      <p class="mt-4 max-w-2xl text-mist">
        Before anyone buys tools or hands AI the keys, find out exactly where your delivery gets
        stuck and what it would take to unstick it.
      </p>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="reveal card-lift bg-ink p-8 text-porcelain lg:col-span-7" data-trail-ignore>
          <p class="font-utility text-xs uppercase tracking-widest text-flare-bright">
            Step one
          </p>
          <h3 class="mt-4 font-display text-3xl font-bold tracking-tight">Delivery Audit</h3>
          <p class="mt-4 max-w-md text-porcelain/80">
            I follow real changes from request to release and note every place they wait on
            someone. You get a plain-English plan for what to automate, in what order, and which
            guardrails have to come first.
          </p>
          <dl class="mt-8 max-w-md space-y-3 font-utility text-sm">
            {
              auditFindings.map(({ item, result }, i) => (
                <div
                  class={`flex justify-between gap-4 ${i < auditFindings.length - 1 ? 'border-b border-dotted border-porcelain/25 pb-3' : ''}`}
                >
                  <dt class="text-porcelain/70">{item}</dt>
                  <dd class="shrink-0 font-bold">{result}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-utility text-sm">
            <span class="uppercase tracking-widest text-porcelain/60">Fixed price · 1–2 weeks</span>
            <a href="/contact/" class="group font-bold underline-offset-4 hover:text-flare-bright hover:underline">
              Book a call to start <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
            </a>
          </p>
        </div>

        <div class="lg:col-span-5">
          <h3 class="font-display text-xl font-bold">If you want it built</h3>
          <p class="mt-2 text-mist">
            Optional. If you go ahead, the audit fee comes off the build.
          </p>
          <dl class="mt-6 border-t border-line">
            {
              afterAudit.map(({ name, body, engagement }) => (
                <div class="reveal border-b border-line py-5">
                  <dt class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <span class="font-display text-lg font-bold">{name}</span>
                    <span class="font-utility text-xs text-flare-deep">{engagement}</span>
                  </dt>
                  <dd class="mt-2 text-mist">{body}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        What the system looks like
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist">
        People set the rules. The system enforces them on every change, so nobody has to remember
        them.
      </p>
      <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6">
        {
          system.map(({ who, name, body, accent }) => (
            <li class={`reveal border-t-4 pt-5 ${accent ? 'border-flare' : 'border-steel'}`}>
              <p
                class={`font-utility text-xs uppercase tracking-widest ${accent ? 'text-flare-deep' : 'text-steel'}`}
              >
                {who}
              </p>
              <p class="mt-2 font-display text-xl font-bold">{name}</p>
              <p class="mt-2 text-mist">{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
          How I work every day
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-mist">
          I run my own work this way, including this site. It's the same setup I'd help you build,
          sized to your team.
        </p>
      </div>
      <ul class="border-t border-line lg:col-span-7">
        {
          ownSetup.map((line) => (
            <li class="reveal flex gap-4 border-b border-line py-5">
              <span class="mt-2.5 h-2 w-2 flex-none bg-flare" aria-hidden="true" />
              <span class="text-ink">{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        Fair questions
      </h2>
      <dl class="mt-10 grid gap-x-12 md:grid-cols-3">
        {
          questions.map(({ q, a }) => (
            <div class="reveal border-t border-line py-6">
              <dt class="font-display text-lg font-bold">{q}</dt>
              <dd class="mt-2 max-w-prose text-mist">{a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="reveal border-2 border-dashed border-ink bg-white p-8 sm:p-10">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Not sure where to start?</h2>
      <p class="mt-4 max-w-2xl text-mist">
        Book a free 15-minute call and walk me through how a change gets from idea to live today.
        I'll tell you where it's stuck, whether or not we work together.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        <a href="/contact/" class="btn-primary text-center sm:text-left">Book the call</a>
        <a href="/about/" class="btn-secondary text-center sm:text-left">More about me →</a>
      </div>
    </div>
  </section>
</Base>
