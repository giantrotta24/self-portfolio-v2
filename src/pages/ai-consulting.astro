---
import Base from '../layouts/Base.astro';
import StatGrid from '../components/StatGrid.astro';

const situations = [
  {
    title: 'Starting from nothing',
    body: 'Your team is curious about AI, a few people are trying it, and nobody has decided what good looks like. I set up a way of working with you and run it on real work until your team can run it without me.',
  },
  {
    title: 'Everyone does it differently',
    body: 'AI is already part of how your team works, but everyone uses it in their own way and nobody can easily tell what it did. I find where it breaks down and turn what works into one shared process you can check.',
  },
];

const steps = [
  { n: 1, name: 'Agree on the problem', person: true },
  { n: 2, name: 'Find the real cause' },
  { n: 3, name: 'Do the work' },
  { n: 4, name: 'Prove it works' },
  { n: 5, name: 'Approve it before it goes live', person: true },
  { n: 6, name: 'Write down what we learned' },
];

const metrics = [
  { label: 'Problems', value: '40+', note: 'taken from report to finished fix' },
  { label: 'Fixes', value: '20+', note: 'live for real users' },
  { label: 'No change needed', value: '6', note: 'times the right call was to change nothing' },
];

const questions = [
  {
    q: 'Can we trust what it produces?',
    a: 'Nothing reaches your customers without a person approving it, and every change comes with proof that it works.',
  },
  {
    q: 'Is AI helping my team, or just creating more work?',
    a: "That's what the checkup answers. Some teams get real time back. Others spend that time checking AI's work. You'll know which one you are.",
  },
  {
    q: 'Do I need to understand the technical side?',
    a: 'No. Reports come in plain English, and every recommendation says what it costs and what you get.',
  },
];

const offers = [
  {
    name: 'AI Checkup',
    tagline: 'The low-risk front door.',
    description:
      "I spend a week or two with your team, learning how work gets done today. I map where AI is helping, where it's adding risk, and where a person needs to stay in charge. You get a plain-English report with what to change first. If a pilot makes sense afterward, the checkup fee comes off the price.",
    engagement: 'Fixed price · 1–2 weeks',
  },
  {
    name: 'AI Pilot',
    tagline: 'The process, running on your work.',
    description:
      "I set up the process on one real project and run real work through it alongside your team. When we're done, your team owns it: the written steps, the checks, and the safety rules.",
    engagement: 'Fixed price · 4–6 weeks',
  },
  {
    name: 'Team Workshop',
    tagline: 'Half a day with your team.',
    description:
      'A working session on how the process works and why each step exists, ending with a live run on a real piece of your work.',
    engagement: 'Fixed price · half day',
  },
  {
    name: 'Advisory',
    tagline: 'Someone to check in with.',
    description:
      'Monthly time for questions, a second opinion on new tools, and help expanding the process as your team trusts it with more.',
    engagement: 'Monthly retainer',
  },
];
---

<Base
  title="AI You Can Trust With Your Software | Gian Trotta"
  description="I help founders and leaders build trust in AI one step at a time, with a person in charge of what reaches customers. Plain-English advice, fixed prices."
  noindex
>
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-16">
    <p class="eyebrow eyebrow-accent">For founders and software leaders</p>
    <h1
      class="mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-balance sm:text-5xl"
    >
      AI you can <span class="hero-underline">trust with your software.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-mist">
      I help companies build trust in AI one step at a time: clear rules, proof for every change,
      and a person in charge of what goes live. You don't need to be technical to work with me.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
      <a href="/contact/" class="btn-primary text-center sm:text-left">Book a free 15-minute call</a>
      <a href="/case-studies/edhlab/" class="btn-secondary text-center sm:text-left">See it on a real product →</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
      Two places teams get stuck
    </h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        situations.map(({ title, body }) => (
          <article class="reveal card-lift border border-line bg-white p-6">
            <h3 class="font-display text-xl font-semibold">{title}</h3>
            <p class="mt-3 text-mist">{body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        How trust gets built
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
        Every piece of work follows the same steps. A person agrees on the problem at the start and
        approves the result at the end. AI does the legwork in between, and each step has to show
        its work before the next one starts.
      </p>
      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map(({ n, name, person }) => (
            <li
              class={`reveal card-lift flex items-center gap-3 border border-line bg-porcelain p-4 ${person ? 'border-t-4 border-t-flare' : ''}`}
            >
              <span
                class={`grid h-8 w-8 flex-none place-items-center font-display text-base font-bold text-porcelain ${person ? 'bg-flare-deep' : 'bg-steel'}`}
              >
                {n}
              </span>
              <span class="font-display font-semibold">
                {name}
                {person && (
                  <span class="mt-1 block font-utility text-xs font-semibold uppercase tracking-wider text-flare-deep">
                    A person decides
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
      Proof from a live product
    </h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
      I run this process as a contractor on a live multiplayer game platform. Since mid-August
      2026:
    </p>
    <div class="reveal mt-6">
      <StatGrid stats={metrics} cols={3} noteClass="mt-1 font-utility text-xs" />
    </div>
    <p class="mt-6 max-w-3xl text-mist">
      Those six matter. The problem had already been solved, wasn't a problem after all, or needed
      a business decision first. A process that always produces a change is one you can't trust.
    </p>
    <a href="/case-studies/edhlab/" class="btn-secondary mt-6 inline-block">
      Read the full story →
    </a>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        Fair questions to ask
      </h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {
          questions.map(({ q, a }) => (
            <article class="reveal card-lift border border-line bg-porcelain p-6">
              <h3 class="font-display text-lg font-semibold">{q}</h3>
              <p class="mt-3 text-mist">{a}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
      Ways to work together
    </h2>
    <div class="mt-8 space-y-8">
      {
        offers.map(({ name, tagline, description, engagement }) => (
          <article class="reveal border border-line bg-white p-8 transition-all duration-200 hover:-translate-y-1 hover:border-ink hover:shadow-lg motion-reduce:hover:translate-y-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-2xl font-bold">{name}</h3>
              <p class="font-utility text-sm text-flare-deep">{engagement}</p>
            </div>
            <p class="mt-1 font-semibold text-steel">{tagline}</p>
            <p class="mt-3 max-w-3xl text-mist">{description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        What I won't promise
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
        AI that runs your product on its own. I'll also tell you where I think it should stay out.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="reveal border-2 border-dashed border-ink bg-white p-8 sm:p-10">
      <h2 class="section-heading font-display text-2xl font-bold sm:text-3xl">
        Not sure where your team fits?
      </h2>
      <p class="mt-4 max-w-2xl text-mist">
        Start with a free 15-minute call. You'll leave knowing what your team's AI setup needs,
        whether or not we work together.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        <a href="/contact/" class="btn-primary text-center sm:text-left">Book the call</a>
        <a href="/about/" class="btn-secondary text-center sm:text-left">More about me →</a>
      </div>
    </div>
  </section>
</Base>
