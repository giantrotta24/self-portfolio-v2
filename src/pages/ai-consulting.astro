---
import Base from '../layouts/Base.astro';
import StatGrid from '../components/StatGrid.astro';

const situations = [
  {
    title: 'Starting from nothing',
    body: 'Your engineers are curious, a few are experimenting, and nobody has decided what good looks like. I design the pipeline with you and run it on real tickets until your team can run it without me.',
  },
  {
    title: 'Everyone does it differently',
    body: "AI is already in the workflow, but every engineer has a private setup and your reviewers can't see what the agent did. I find where it breaks down and turn the parts that work into a shared setup your reviewers can check.",
  },
];

const steps = [
  { n: 1, name: 'Agree on the problem', gate: true },
  { n: 2, name: 'Find the real cause' },
  { n: 3, name: 'Write the brief' },
  { n: 4, name: 'Build it, test-first' },
  { n: 5, name: 'Prove it on screen' },
  { n: 6, name: 'Review it hard' },
  { n: 7, name: 'Open the pull request', gate: true },
  { n: 8, name: 'Write it down' },
];

const metrics = [
  { label: 'Issues run', value: '40+', note: 'from bug report to reviewed fix' },
  { label: 'Fixes', value: '20+', note: 'merged and live' },
  { label: 'Correct no-ships', value: '6', note: 'the right answer was to ship nothing' },
];

const misses = [
  'Three passing tests missed buttons covering the header. Now every visual change needs before-and-after screenshots.',
  'Early pull requests went out with the wrong scope, and one fixed code that was already working. Now nothing opens a pull request without an independent review, and a second reviewer challenges every finding before anyone acts on it.',
  "Dead ends get written down, so the next run doesn't spend time re-checking them.",
];

const offers = [
  {
    name: 'Pipeline Checkup',
    tagline: 'The low-risk front door.',
    description:
      "I spend a week or two with your team, your repos, and your review process, and map every point where a person has to step in. You get a plain report: what's working, where AI is adding risk or slowing you down, and what to change first. If a pilot makes sense afterward, the checkup fee comes off the price.",
    engagement: 'Fixed price · 1–2 weeks',
  },
  {
    name: 'Pipeline Pilot',
    tagline: 'The pipeline, running on your code.',
    description:
      "I set up the loop on one repository and run real tickets through it alongside your engineers. When we're done, your team owns the setup: the instructions, the checks, and the guardrails.",
    engagement: 'Fixed price · 4–6 weeks',
  },
  {
    name: 'Team Workshop',
    tagline: 'Half a day, your codebase.',
    description:
      'A working session for your engineers on how the loop works and why each checkpoint exists, ending with a live run on a real ticket from your backlog.',
    engagement: 'Fixed price · half day',
  },
  {
    name: 'Advisory',
    tagline: 'Someone to check in with.',
    description:
      'Monthly time for questions, reviews of new workflows, and help widening the pipeline as your team trusts it with more.',
    engagement: 'Monthly retainer',
  },
];
---

<Base
  title="AI-Assisted Development for Engineering Teams | Gian Trotta"
  description="I help engineering teams turn scattered AI use into a development pipeline with clear checkpoints and proof on every change."
  noindex
>
  <section class="mx-auto max-w-5xl px-6 pb-12 pt-16">
    <p class="eyebrow eyebrow-accent">For engineering teams</p>
    <h1 class="mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-balance sm:text-5xl">
      AI-assisted development that <span class="hero-underline">survives code review.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-mist">
      I help engineering teams turn scattered AI use into a pipeline reviewers can trust.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/contact/" class="btn-primary">Book a free 15-minute call</a>
      <a href="/case-studies/edhlab/" class="btn-secondary">See how I work →</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-16">
    <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
      Two places teams get stuck
    </h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        situations.map(({ title, body }) => (
          <article class="reveal card-lift border border-line bg-white p-6">
            <h3 class="font-display text-xl font-semibold">{title}</h3>
            <p class="mt-3 text-mist">{body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        One loop, two human checkpoints
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
        Every change goes through the same eight steps. A person owns the first and the seventh.
        The agent does the work in between, and each step has a check it has to pass before the
        next one starts.
      </p>
      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map(({ n, name, gate }) => (
            <li
              class={`reveal card-lift flex items-center gap-3 border border-line bg-porcelain p-4 ${gate ? 'border-t-4 border-t-flare' : ''}`}
            >
              <span
                class={`grid h-8 w-8 flex-none place-items-center font-display text-base font-bold text-porcelain ${gate ? 'bg-flare-deep' : 'bg-steel'}`}
              >
                {n}
              </span>
              <span class="font-display font-semibold">
                {name}
                {gate && (
                  <span class="mt-1 block font-utility text-xs font-semibold uppercase tracking-wider text-flare-deep">
                    Checkpoint
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
      Proof from a live product
    </h2>
    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
      I run this loop as a contractor on a live multiplayer game platform. Since mid-August 2026:
    </p>
    <div class="reveal mt-6">
      <StatGrid stats={metrics} cols={3} noteClass="mt-1 font-utility text-xs" />
    </div>
    <p class="mt-6 max-w-3xl text-mist">
      Six times the right answer was to ship nothing. The bug was already fixed, the report
      described expected behavior, or the fix needed a product decision first. I built the
      pipeline to reach that answer instead of forcing a fix.
    </p>
    <a href="/case-studies/edhlab/" class="btn-secondary mt-6 inline-block">
      Read the full case study →
    </a>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        Guardrails, and the misses that made them
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
        Every rule in the pipeline exists because something got through without it.
      </p>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        {
          misses.map((body) => (
            <article class="reveal card-lift border border-line bg-porcelain p-5">
              <p class="text-sm text-mist">{body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
      Ways to work together
    </h2>
    <div class="mt-8 space-y-8">
      {
        offers.map(({ name, tagline, description, engagement }) => (
          <article class="reveal border border-line bg-white p-8 transition-all duration-200 hover:-translate-y-1 hover:border-ink hover:shadow-lg motion-reduce:hover:translate-y-0">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-2xl font-bold">{name}</h3>
              <p class="font-utility text-sm text-flare-deep">{engagement}</p>
            </div>
            <p class="mt-1 font-semibold text-steel">{tagline}</p>
            <p class="mt-3 max-w-3xl text-mist">{description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="section-heading font-display text-3xl font-bold tracking-tight">
        What I won't promise
      </h2>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-mist">
        Agents that ship on their own. Every pipeline I've built keeps a person at the start and at
        the end. I'll also tell you where I think AI shouldn't touch your code at all.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <div class="reveal border-2 border-dashed border-ink bg-white p-8 sm:p-10">
      <h2 class="section-heading font-display text-2xl font-bold sm:text-3xl">
        Not sure where your team fits?
      </h2>
      <p class="mt-4 max-w-2xl text-mist">
        Start with a free 15-minute call. You'll leave knowing what your team's AI setup needs,
        whether or not we work together.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/contact/" class="btn-primary">Book the call</a>
        <a href="/about/" class="btn-secondary">More about me →</a>
      </div>
    </div>
  </section>
</Base>
