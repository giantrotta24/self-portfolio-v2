---
import Base from '../layouts/Base.astro';
import AvailabilityBadge from '../components/AvailabilityBadge.astro';
import StatGrid from '../components/StatGrid.astro';

const proofStats = [
  { label: 'Monthly fee', value: '$0' },
  { label: 'Loads in', value: '< 1 second' },
  { label: 'On Google', value: 'Found' },
];
---

<Base
  title="Gian Trotta — Fast websites for Northeast Ohio small businesses"
  description="Your website should bring in customers, not another monthly bill. Website rescues, rebuilds, and checkups for Northeast Ohio small businesses."
>
  <!-- Hero: headline vs. the receipt that proves it -->
  <section class="mx-auto max-w-6xl overflow-x-clip px-6 pb-20 pt-16 lg:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-7">
        <p class="eyebrow eyebrow-accent text-sm! flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="w-full sm:w-auto">Cleveland, Ohio</span>
          <span aria-hidden="true" class="hidden sm:inline">·</span>
          <AvailabilityBadge />
        </p>
        <h1
          class="mt-4 max-w-full font-display text-4xl font-bold leading-[1.15] tracking-tight text-balance sm:text-5xl md:text-6xl"
        >
          Your website should bring in customers,{' '}
          <span class="hero-underline">not&nbsp;another monthly bill.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-mist">
          I get small-business sites off monthly builders and onto something that loads quickly
          and Google can actually find.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <a href="/contact/" class="btn-primary text-center sm:text-left">
            Book a free 15-minute call
          </a>
          <a href="/services/" class="btn-secondary text-center sm:text-left">
            See services
          </a>
        </div>
      </div>

      <!-- Signature: the checkup receipt — this site's own diagnostic slip -->
      <aside
        class="receipt-wrap min-w-0 w-full max-w-md justify-self-center transition-transform duration-300 sm:max-w-lg lg:col-span-5 lg:max-w-none lg:justify-self-stretch lg:-rotate-2 lg:hover:rotate-0 motion-reduce:transition-none"
        aria-label="This site's own checkup results"
      >
        <div class="receipt-paper px-5 py-8 font-utility sm:px-7 sm:py-9">
          <p class="text-xs uppercase tracking-widest text-mist">
            Site checkup · giantrotta.dev
          </p>
          <dl class="mt-5 space-y-3 text-sm">
            <div class="flex justify-between gap-3 border-b border-dotted border-line pb-3">
              <dt class="min-w-0">Google speed score</dt>
              <dd class="shrink-0 font-bold text-steel">100 / 100</dd>
            </div>
            <div class="flex justify-between gap-3 border-b border-dotted border-line pb-3">
              <dt class="min-w-0">Loads in</dt>
              <dd class="shrink-0 font-bold text-steel">under 1 second</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="min-w-0">Monthly platform fee</dt>
              <dd class="shrink-0 font-bold text-flare-deep">$0</dd>
            </div>
          </dl>
          <p class="mt-6 border-t border-dashed border-line pt-4 text-xs leading-relaxed text-mist">
            This site is built the way I build yours. The previous version took 72 seconds to load
            on a phone.
            <a
              href="/blog/why-my-portfolio-took-72-seconds-to-load/"
              class="group underline hover:text-ink"
            >
              That story <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
            </a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Services teaser: flagship door + one catalog link -->
  <section class="border-t border-line bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="eyebrow">Services</p>
      <h2 class="section-heading mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Start with a rescue
      </h2>
      <p class="mt-4 max-w-2xl text-mist">
        Most owners come in stuck on a monthly builder. New builds, checkups, and care plans are
        on the services page when you need them.
      </p>

      <a
        href="/services/"
        class="group mt-10 flex max-w-3xl flex-col justify-between bg-ink p-8 text-porcelain transition-transform duration-200 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
      >
        <div>
          <svg
            class="h-9 w-9 text-flare transition-transform duration-200 group-hover:-rotate-6 group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:rotate-0 motion-reduce:group-hover:scale-100"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2.5 12h4l1.8-4.5L11 16l2.2-8 1.5 4.5h6.8" />
          </svg>
          <p class="mt-4 font-utility text-xs uppercase tracking-widest text-flare-bright">
            Most rescues start here
          </p>
          <h3 class="mt-4 font-display text-3xl font-bold tracking-tight">Website Rescue</h3>
          <p class="mt-4 max-w-md text-porcelain/80">
            Stuck on a slow Wix or Squarespace site? I rebuild it fast and fee-free,
            subscription cancelled for good.
          </p>
          <dl class="mt-8 max-w-md space-y-3 font-utility text-sm">
            <div class="flex justify-between gap-4 border-b border-dotted border-porcelain/25 pb-3">
              <dt class="text-porcelain/70">Platform subscription</dt>
              <dd class="font-bold text-flare-bright">cancelled</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-dotted border-porcelain/25 pb-3">
              <dt class="text-porcelain/70">Your content &amp; domain</dt>
              <dd class="font-bold">kept</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-porcelain/70">Google &amp; AI search</dt>
              <dd class="font-bold">findable</dd>
            </div>
          </dl>
        </div>
        <p class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-utility text-sm">
          <span class="uppercase tracking-widest text-porcelain/60">Fixed price · 2–3 weeks</span>
          <span class="font-bold group-hover:text-flare-bright">How a rescue works →</span>
        </p>
      </a>

      <a href="/services/" class="group mt-8 inline-block font-semibold text-steel underline">
        Other fixed-price options
        <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </section>

  <!-- Proof strip -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="eyebrow">Case study</p>
    <h2 class="section-heading mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Recent rescue
    </h2>
    <p class="mt-4 max-w-2xl text-mist">
      A children's book author was paying monthly for a slow Wix site. I rebuilt it: loads in under
      a second, found on Google, and the platform fee went to zero.
    </p>

    <div class="mt-8 max-w-3xl">
      <StatGrid stats={proofStats} cols={3} valueClass="text-2xl" />
    </div>

    <a href="/case-studies/rusty/" class="group mt-8 inline-block font-semibold text-steel underline">
      Read the case study
      <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
    </a>
  </section>

  <!-- Close on the handshake, not the résumé -->
  <section class="border-t border-line bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="max-w-3xl border-2 border-dashed border-ink bg-porcelain p-8">
        <h2 class="section-heading font-display text-2xl font-bold tracking-tight sm:text-3xl">
          Not sure which door fits?
        </h2>
        <p class="mt-3 max-w-xl text-mist">
          Book a free 15-minute call. You'll leave knowing what your site needs, whether or not we
          work together. No pitch deck required.
        </p>
        <a href="/contact/" class="btn-primary mt-6 inline-block">
          Book a free 15-minute call
        </a>
      </div>
    </div>
  </section>
</Base>
